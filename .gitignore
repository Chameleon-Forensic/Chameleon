# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# PyInstaller build ciktisi (dist/build klasorleri) -- ama elle yazilan
# src/build.spec/src/build_target_kit.spec (paketleme tarifleri) commit
# edilmeli, otomatik uretilen .spec'ler degil, o yuzden ozel olarak
# istisna tutuluyor.
build/
dist/
*.spec
!src/build.spec
!src/build_target_kit.spec

# Imaj / rapor / log ciktilari (hicbir zaman commit edilmez)
*.raw
*.dd
*.img
*.E01
*.aff4
logs/*.log
**/logs/*.log
**/ssh_engine/logs/
*_chain_of_custody.json
*_audit_log.txt
*_integrity_report.html
bitguard_crash_log.txt
images/
**/local_collector/images/

# Operator'un Tor client-auth OZEL anahtari -- asla commit edilmez, her
# operatorde yerel/farkli olmali (bkz. gui_v2.py/gui_v2_qt.py
# _load_or_create_operator_key). Gercek yol PROJECT_ROOT'a (ssh_engine/,
# local_collector'in BIR UST dizini) gore -- onceki desen
# "**/local_collector/keys/" hicbir zaman eslesmiyordu, duzeltildi.
**/ssh_engine/keys/

# Vaka gecmisi listesi + gercek rapor ciktilari -- kisisel/vaka verisi,
# her kurulumda yerel/farkli olmali (bkz. src/shared/forensic_report.py)
src/shared/data/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.env

# Claude Code'un kendi yerel arac ayarlari -- gelistiriciye/makineye ozel
.claude/

# AI oturum/gelistirme notlari -- yazilimin calismasi icin gerekli degil,
